<?xml version="1.0" encoding="utf-8"?>
<!-- Nội dung bên trong NavRowView.kt (B3), được inflate làm con duy nhất của MaterialCardView.
     ivIcon/tvSubtitle/tvValue tự ẩn khi không có dữ liệu - xem các hàm set...() trong NavRowView.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/card_padding_horizontal">

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="@dimen/icon_medium"
        android:layout_height="@dimen/icon_medium"
        android:contentDescription="@null"
        tools:src="@drawable/ic_back" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.App.Body"
            tools:text="Language" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.App.Caption"
            android:visibility="gone"
            tools:text="Tap for more settings"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_8"
        android:textAppearance="@style/TextAppearance.App.Body"
        android:textColor="@color/primary"
        android:visibility="gone"
        tools:text="English"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/ivChevron"
        android:layout_width="@dimen/icon_small"
        android:layout_height="@dimen/icon_small"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right" />
</LinearLayout>
