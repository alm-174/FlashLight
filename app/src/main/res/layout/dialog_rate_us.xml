<?xml version="1.0" encoding="utf-8"?>
<!-- Lề ngoài 16 → thẻ rộng 328 trên màn 360, đúng Figma -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rate_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivEmoji"
                android:layout_width="@dimen/rate_emoji"
                android:layout_height="@dimen/rate_emoji"
                android:layout_marginTop="10dp"
                android:layout_gravity="center_horizontal"
                android:importantForAccessibility="no"
                android:src="@drawable/img_rate_default" />

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                app:tint="@color/text_secondary" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pathway_extreme_medium"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/pathway_extreme_regular"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/layoutStars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <ImageView android:id="@+id/star1" android:layout_width="@dimen/rate_star" android:layout_height="@dimen/rate_star" android:contentDescription="@null" android:src="@drawable/ic_star" />
            <ImageView android:id="@+id/star2" android:layout_width="@dimen/rate_star" android:layout_height="@dimen/rate_star" android:layout_marginStart="@dimen/rate_star_gap" android:contentDescription="@null" android:src="@drawable/ic_star" />
            <ImageView android:id="@+id/star3" android:layout_width="@dimen/rate_star" android:layout_height="@dimen/rate_star" android:layout_marginStart="@dimen/rate_star_gap" android:contentDescription="@null" android:src="@drawable/ic_star" />
            <ImageView android:id="@+id/star4" android:layout_width="@dimen/rate_star" android:layout_height="@dimen/rate_star" android:layout_marginStart="@dimen/rate_star_gap" android:contentDescription="@null" android:src="@drawable/ic_star" />
            <ImageView android:id="@+id/star5" android:layout_width="@dimen/rate_star" android:layout_height="@dimen/rate_star" android:layout_marginStart="@dimen/rate_star_gap" android:contentDescription="@null" android:src="@drawable/ic_star" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="@dimen/rate_button_height"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_rate_submit"
            android:fontFamily="@font/pathway_extreme_semibold"
            android:gravity="center"
            android:text="@string/rate_submit"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />
    </LinearLayout>
</FrameLayout>