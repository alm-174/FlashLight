<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".ui.settings.SettingsActivity">

    <!-- Header: ← | Settings -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_header_height">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:fontFamily="@font/pathway_extreme_semibold"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />
    </FrameLayout>

    <!-- Danh sách: lề 16, mỗi hàng cách nhau 16 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding">

        <include
            android:id="@+id/rowLanguage"
            layout="@layout/view_settings_row" />

        <include
            android:id="@+id/rowShare"
            layout="@layout/view_settings_row"
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_row_height"
            android:layout_marginTop="@dimen/settings_row_gap" />

        <include
            android:id="@+id/rowRate"
            layout="@layout/view_settings_row"
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_row_height"
            android:layout_marginTop="@dimen/settings_row_gap" />

        <include
            android:id="@+id/rowPrivacy"
            layout="@layout/view_settings_row"
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_row_height"
            android:layout_marginTop="@dimen/settings_row_gap" />

        <include
            android:id="@+id/rowPolicy"
            layout="@layout/view_settings_row"
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_row_height"
            android:layout_marginTop="@dimen/settings_row_gap" />
    </LinearLayout>
</LinearLayout>