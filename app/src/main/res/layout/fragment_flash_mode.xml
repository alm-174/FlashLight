<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="@dimen/flash_state_top">

    <TextView
        android:id="@+id/tvState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pathway_extreme_semibold"
        android:shadowColor="#40000000"
        android:shadowDy="4"
        android:shadowRadius="4"
        android:textColor="@color/text_primary"
        android:textSize="36sp"
        tools:text="OFF" />

    <!-- Khung 300dp: vòng tròn 220 nằm giữa → mép trên vòng tròn lùi 40dp, nên marginTop -20 = cách chữ 20 -->
    <FrameLayout
        android:layout_width="@dimen/flash_glow"
        android:layout_height="@dimen/flash_glow"
        android:layout_marginTop="-20dp">

        <View
            android:id="@+id/viewGlow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_flash_glow"
            android:visibility="invisible" />

        <FrameLayout
            android:id="@+id/circle"
            android:layout_width="@dimen/flash_circle"
            android:layout_height="@dimen/flash_circle"
            android:layout_gravity="center"
            android:background="@drawable/bg_flash_circle"
            android:backgroundTint="@color/flash_circle_off"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/ivImage"
                android:layout_width="@dimen/flash_icon"
                android:layout_height="@dimen/flash_icon"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                tools:src="@drawable/img_sos_off" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
