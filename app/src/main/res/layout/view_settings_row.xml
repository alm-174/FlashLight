<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/settings_row_height"
    android:background="@drawable/bg_settings_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="36dp"
        android:layout_height="45dp"
        android:importantForAccessibility="no"
        android:padding="8dp"
        tools:src="@drawable/ic_language" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/pathway_extreme_medium"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        tools:text="Language" />

    <TextView
        android:id="@+id/tvValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pathway_extreme_medium"
        android:textColor="@color/primary"
        android:textSize="16sp"
        android:visibility="gone"
        tools:text="English"
        tools:visibility="visible" />

    <ImageView
        android:layout_width="@dimen/settings_icon_box"
        android:layout_height="@dimen/settings_icon_box"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/text_primary" />
</LinearLayout>