<?xml version="1.0" encoding="utf-8"?>
<!--
  Màn Home – số đo lấy trực tiếp từ Figma (frame 360×800).
  Toàn bộ nội dung cuộn được; padding trên/dưới theo thanh hệ thống được cộng trong HomeActivity.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.home.HomeActivity">

    <LinearLayout
        android:id="@+id/contentHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="5dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/home_bottom_space">

        <!-- ========== HEADER ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppName"
                    android:layout_marginTop="@dimen/text_body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pathway_extreme_semibold"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/home_text_title" />

                <TextView
                    android:id="@+id/tvTagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/pathway_extreme_regular"
                    android:text="@string/home_tagline"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/home_text_caption" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCamera"
                android:layout_width="@dimen/home_header_button"
                android:layout_height="@dimen/home_header_button"
                android:background="@drawable/bg_round_button"
                android:contentDescription="@string/home_camera_cd"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_camera" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="@dimen/home_header_button"
                android:layout_height="@dimen/home_header_button"
                android:layout_marginStart="@dimen/home_header_button_gap"
                android:background="@drawable/bg_round_button"
                android:contentDescription="@string/home_settings_cd"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <!-- ========== THẺ LED ========== -->
        <FrameLayout
            android:id="@+id/cardLed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/home_header_to_card"
            android:background="@drawable/bg_home_card_led">

            <!-- Quầng sáng góc phải trên -->
            <View
                android:layout_width="@dimen/home_hero_glow"
                android:layout_height="@dimen/home_hero_glow"
                android:layout_gravity="top|end"
                android:layout_marginTop="-24dp"
                android:background="@drawable/bg_home_hero_glow" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/home_card_padding"
                android:paddingTop="@dimen/home_hero_padding_vertical"
                android:paddingEnd="@dimen/home_card_padding"
                android:paddingBottom="@dimen/home_hero_padding_vertical">

                <!-- ① HÀNG TRÊN: icon | Hero Section / LED | Play Now! -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="@dimen/home_icon_led"
                        android:layout_height="@dimen/home_icon_led"
                        android:background="@drawable/bg_home_icon_led">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_led_grid"
                            app:tint="@color/primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/home_inner_gap"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pathway_extreme_regular"
                            android:text="@string/home_led_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/home_text_caption" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pathway_extreme_bold"
                            android:text="@string/home_led_title"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/home_text_title" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnPlayNow"
                        android:layout_width="@dimen/home_play_now_width"
                        android:layout_height="@dimen/home_small_button_height"
                        android:background="@drawable/bg_button_gradient"
                        android:foreground="?attr/selectableItemBackground"
                        android:fontFamily="@font/pathway_extreme_bold"
                        android:gravity="center"
                        android:text="@string/home_play_now"
                        android:textColor="@color/on_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- ② Ô CHẠY CHỮ: lưới chấm LED + chữ phát sáng -->
                <FrameLayout
                    android:id="@+id/layoutMarquee"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/home_marquee_height"
                    android:layout_marginTop="@dimen/home_section_gap"
                    android:background="@drawable/bg_home_marquee">

                    <View
                        android:id="@+id/viewLedDots"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="1dp" />

                    <TextView
                        android:id="@+id/tvMarquee"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:ellipsize="marquee"
                        android:fontFamily="@font/pathway_extreme_semibold"
                        android:gravity="center"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:text="@string/home_led_default_marquee"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/home_text_marquee" />
                </FrameLayout>

                <!-- ③ ĐƯỜNG KẺ -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/home_section_gap"
                    android:background="@color/home_led_divider" />

                <!-- ④ HÀNG DƯỚI: • Speed: 5s | RGB Multi-Color | Custom Text → -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp">

                    <View
                        android:layout_width="@dimen/home_dot"
                        android:layout_height="@dimen/home_dot"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/pathway_extreme_regular"
                        android:text="@string/home_speed_label"
                        android:textColor="@color/home_led_label"
                        android:textSize="@dimen/home_text_caption" />

                    <TextView
                        android:id="@+id/tvSpeedValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/pathway_extreme_medium"
                        android:text="@string/home_speed_value"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/home_text_caption" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvLedMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pathway_extreme_regular"
                        android:text="@string/home_led_rgb"
                        android:textColor="@color/home_led_label"
                        android:textSize="@dimen/home_text_caption" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvCustomText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:fontFamily="@font/pathway_extreme_semibold"
                        android:text="@string/home_custom_text"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/home_text_caption" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- ========== 2 THẺ NHỎ: FLASH | FLASH ALERT ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/home_card_gap"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Thẻ Flash -->
            <LinearLayout
                android:id="@+id/cardFlash"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_card_flash"
                android:orientation="vertical"
                android:padding="@dimen/home_card_padding">

                <FrameLayout
                    android:layout_width="@dimen/home_icon_feature"
                    android:layout_height="@dimen/home_icon_feature"
                    android:background="@drawable/bg_home_icon_feature"
                    android:backgroundTint="@color/accent_flash">

                    <ImageView
                        android:layout_width="@dimen/home_icon_inner"
                        android:layout_height="@dimen/home_icon_inner"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_flashlight"
                        app:tint="@color/text_primary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_inner_gap"
                    android:fontFamily="@font/pathway_extreme_semibold"
                    android:text="@string/home_flash_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/home_text_card_title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pathway_extreme_regular"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/home_flash_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/home_text_small" />

                <TextView
                    android:id="@+id/btnExploreModes"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/home_small_button_height"
                    android:layout_marginTop="@dimen/home_inner_gap"
                    android:background="@drawable/bg_home_button_flash"
                    android:foreground="?attr/selectableItemBackground"
                    android:fontFamily="@font/pathway_extreme_medium"
                    android:gravity="center"
                    android:text="@string/home_flash_action"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/home_text_caption" />
            </LinearLayout>

            <!-- Thẻ Flash Alert -->
            <LinearLayout
                android:id="@+id/cardAlert"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_card_alert"
                android:orientation="vertical"
                android:padding="@dimen/home_card_padding">

                <FrameLayout
                    android:layout_width="@dimen/home_icon_feature"
                    android:layout_height="@dimen/home_icon_feature"
                    android:background="@drawable/bg_home_icon_feature"
                    android:backgroundTint="@color/accent_blue">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_siren_home" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_inner_gap"
                    android:fontFamily="@font/pathway_extreme_semibold"
                    android:text="@string/home_alert_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/home_text_card_title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pathway_extreme_regular"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/home_alert_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/home_text_small" />

                <TextView
                    android:id="@+id/btnSetUpAlerts"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/home_small_button_height"
                    android:layout_marginTop="@dimen/home_inner_gap"
                    android:background="@drawable/bg_home_button_alert"
                    android:foreground="?attr/selectableItemBackground"
                    android:fontFamily="@font/pathway_extreme_medium"
                    android:gravity="center"
                    android:text="@string/home_alert_action"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/home_text_caption" />
            </LinearLayout>
        </LinearLayout>

        <!-- ========== THẺ SCREENLIGHT ========== -->
        <LinearLayout
            android:id="@+id/cardScreenlight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/home_card_gap"
            android:background="@drawable/bg_home_card_screenlight"
            android:orientation="vertical"
            android:paddingStart="@dimen/home_card_padding"
            android:paddingTop="@dimen/home_card_padding"
            android:paddingEnd="@dimen/home_card_padding"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="@dimen/home_icon_feature"
                    android:layout_height="@dimen/home_icon_feature"
                    android:background="@drawable/bg_home_icon_feature"
                    android:backgroundTint="@color/accent_blue">

                    <ImageView
                        android:layout_width="@dimen/home_icon_inner"
                        android:layout_height="@dimen/home_icon_inner"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_sun"
                        app:tint="@color/text_primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/home_inner_gap"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pathway_extreme_semibold"
                        android:text="@string/home_screenlight_title"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/home_text_card_title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pathway_extreme_regular"
                        android:text="@string/home_screenlight_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/home_text_small" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnScreenlightOpen"
                    android:layout_width="@dimen/home_arrow_button"
                    android:layout_height="@dimen/home_arrow_button"
                    android:background="@drawable/bg_home_arrow_button"
                    android:contentDescription="@string/home_screenlight_title"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/text_primary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="@color/accent_blue_15" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/home_section_gap">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pathway_extreme_regular"
                    android:text="@string/home_preset"
                    android:textColor="@color/home_preset_label"
                    android:textSize="@dimen/home_text_small" />

                <!-- 5 màu preset: mỗi ô 32dp, chấm màu 24dp ở giữa; ô đang chọn có vòng viền -->
                <LinearLayout
                    android:id="@+id/layoutPresets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/preset1"
                        android:layout_width="@dimen/home_preset_slot"
                        android:layout_height="@dimen/home_preset_slot"
                        android:background="@drawable/bg_home_preset_ring">
                        <View
                            android:layout_width="@dimen/home_preset_dot"
                            android:layout_height="@dimen/home_preset_dot"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/home_preset_1" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/preset2"
                        android:layout_width="@dimen/home_preset_slot"
                        android:layout_height="@dimen/home_preset_slot">
                        <View
                            android:layout_width="@dimen/home_preset_dot"
                            android:layout_height="@dimen/home_preset_dot"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/home_preset_2" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/preset3"
                        android:layout_width="@dimen/home_preset_slot"
                        android:layout_height="@dimen/home_preset_slot">
                        <View
                            android:layout_width="@dimen/home_preset_dot"
                            android:layout_height="@dimen/home_preset_dot"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/home_preset_3" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/preset4"
                        android:layout_width="@dimen/home_preset_slot"
                        android:layout_height="@dimen/home_preset_slot">
                        <View
                            android:layout_width="@dimen/home_preset_dot"
                            android:layout_height="@dimen/home_preset_dot"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/home_preset_4" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/preset5"
                        android:layout_width="@dimen/home_preset_slot"
                        android:layout_height="@dimen/home_preset_slot">
                        <View
                            android:layout_width="@dimen/home_preset_dot"
                            android:layout_height="@dimen/home_preset_dot"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/home_preset_5" />
                    </FrameLayout>
                </LinearLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvAdjust"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="2dp"
                    android:fontFamily="@font/pathway_extreme_medium"
                    android:gravity="center_vertical"
                    android:text="@string/home_adjust"
                    android:textColor="@color/accent_blue"
                    android:textSize="@dimen/home_text_caption"
                    app:drawableEndCompat="@drawable/ic_chevron_right"
                    app:drawableTint="@color/accent_blue" />
            </LinearLayout>
        </LinearLayout>

        <!-- ========== THẺ EDGE LIGHTING ========== -->
        <LinearLayout
            android:id="@+id/cardEdge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/home_card_gap"
            android:background="@drawable/bg_home_card_edge"
            android:orientation="vertical"
            android:paddingStart="@dimen/home_card_padding"
            android:paddingTop="@dimen/home_card_padding"
            android:paddingEnd="@dimen/home_card_padding"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="@dimen/home_icon_feature"
                    android:layout_height="@dimen/home_icon_feature"
                    android:background="@drawable/bg_home_icon_feature_large"
                    android:backgroundTint="@color/accent_flash">

                    <ImageView
                        android:layout_width="@dimen/home_icon_inner"
                        android:layout_height="@dimen/home_icon_inner"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_monitor"
                        app:tint="@color/text_primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/home_inner_gap"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pathway_extreme_medium"
                        android:text="@string/home_edge_title"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/home_text_card_title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pathway_extreme_regular"
                        android:text="@string/home_edge_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/home_text_small" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnEdgeOpen"
                    android:layout_width="@dimen/home_arrow_button"
                    android:layout_height="@dimen/home_arrow_button"
                    android:background="@drawable/bg_home_arrow_button"
                    android:contentDescription="@string/home_edge_title"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/text_primary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="@color/home_edge_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/home_section_gap">

                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/home_rainbow_height"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_rainbow" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/home_inner_gap"
                    android:fontFamily="@font/pathway_extreme_medium"
                    android:text="@string/home_edge_effect"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/home_text_caption" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>