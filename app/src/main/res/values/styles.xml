<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Typography -->
    <style name="TextAppearance.App.LargeTitle" parent="">
        <item name="android:textSize">@dimen/text_large_title</item>
        <item name="android:fontFamily">@font/pathway_extreme_semibold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.ScreenTitle" parent="">
        <item name="android:textSize">@dimen/text_screen_title</item>
        <item name="android:fontFamily">@font/pathway_extreme_semibold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Title" parent="">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">@font/pathway_extreme_semibold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Subhead" parent="">
        <item name="android:textSize">@dimen/text_subhead</item>
        <item name="android:fontFamily">@font/pathway_extreme_medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Body" parent="">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">@font/pathway_extreme_regular</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.BodySecondary" parent="">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">@font/pathway_extreme_regular</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.App.Caption" parent="">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:fontFamily">@font/pathway_extreme_regular</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.App.Button" parent="">
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:fontFamily">@font/pathway_extreme_semibold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.App.Button.Filled" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@color/selector_button_filled_bg</item>
        <item name="android:textColor">@color/selector_button_filled_text</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:fontFamily">@font/pathway_extreme_semibold</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@color/transparent</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:fontFamily">@font/pathway_extreme_semibold</item>
    </style>

    <!-- Card -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">@dimen/radius_card_setting</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Slider: track cao 8dp bo 4dp màu track (#353534), núm 24dp (bán kính 12dp) -->
    <style name="Widget.App.Slider" parent="Widget.Material3.Slider">
        <item name="trackColorActive">@color/primary</item>
        <item name="trackColorInactive">@color/track</item>
        <item name="thumbColor">@color/primary</item>
        <item name="trackHeight">@dimen/slider_track_height</item>
        <item name="thumbRadius">@dimen/slider_thumb_radius</item>
        <item name="labelBehavior">gone</item>
    </style>

    <!-- Chip: nền surface, viền stroke, bo 8dp; khi checked: viền primary, chữ primary -->
    <style name="Widget.App.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/surface</item>
        <item name="chipStrokeColor">@color/selector_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/selector_chip_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipCornerRadius">@dimen/radius_chip</item>
    </style>

    <!-- B8: nút gradient primary -> primary_gradient_end, dùng cho "Play Now!" và các nút xanh nổi bật ở Home.
         backgroundTint phải để @null vì MaterialButton mặc định tô 1 màu phẳng đè lên android:background. -->
    <style name="Widget.App.Button.Gradient" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/button_height_small</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/bg_button_gradient</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/on_accent_dark</item>
        <item name="android:textSize">@dimen/text_button_small</item>
        <item name="android:fontFamily">@font/pathway_extreme_bold</item>
    </style>

    <!-- B8: nút nhỏ kiểu "Play Now!" / "Explore Modes" ở Home -->
    <style name="Widget.App.Button.Small" parent="Widget.App.Button.Filled">
        <item name="android:minHeight">@dimen/button_height_small</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textSize">@dimen/text_button_small</item>
    </style>

    <!-- Nút "Next" Onboarding (B8): pill bo 999dp, cao 40dp, padding 8/16dp, nền surface, viền stroke, chữ 16sp SemiBold primary -->
    <style name="Widget.App.Button.Pill" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">40dp</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="strokeWidth">@dimen/stroke_thin</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">@dimen/text_subhead</item>
        <item name="android:fontFamily">@font/pathway_extreme_semibold</item>
        <item name="android:paddingHorizontal">@dimen/space_16</item>
        <item name="android:paddingVertical">@dimen/space_8</item>
    </style>

    <!-- B2: thẻ lớn ở Home (LED Hero, Screenlight...), nền layer-list bg_card_large thay cho màu phẳng. -->
    <style name="Widget.App.Card.Large" parent="Widget.App.Card">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardBackgroundColor">@color/transparent</item>
        <item name="android:background">@drawable/bg_card_large</item>
    </style>

    <!-- B4: Switch dùng ở hàng công tắc (view_switch_row.xml). track primary khi bật, switch_off (#666D80) khi tắt. -->
    <style name="Widget.App.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackTint">@color/selector_switch_track</item>
        <item name="thumbTint">@android:color/white</item>
        <item name="trackDecorationTint">@android:color/transparent</item>
    </style>

    <!-- Tiêu đề thẻ: "Brightness", "Color", "Direction"... – Medium 16 trắng -->
    <style name="Ft.Text.CardTitle" parent="">
        <item name="android:fontFamily">@font/pathway_extreme_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Giá trị bên phải tiêu đề: "80%", "5s", "64px" – Medium 16 xanh -->
    <style name="Ft.Text.Value" parent="Ft.Text.CardTitle">
        <item name="android:textColor">@color/primary</item>
    </style>

    <!-- Nhãn phụ: "Flashing ON", "Top Radius" – Medium 14/16 xám -->
    <style name="Ft.Text.Label" parent="Ft.Text.CardTitle">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Chữ nút chính – SemiBold 18 trắng -->
    <style name="Ft.Text.Button" parent="">
        <item name="android:fontFamily">@font/pathway_extreme_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Thẻ nội dung: nền surface, viền stroke, bo 12, padding 21 -->
    <style name="Ft.Card" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/ft_card_gap</item>
        <item name="android:background">@drawable/bg_ft_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/ft_card_padding</item>
    </style>

    <!-- Nút chính màu xanh, cao 48, bo 12 -->
    <style name="Ft.Button.Primary" parent="Ft.Text.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/ft_button_height</item>
        <item name="android:background">@drawable/bg_ft_button_primary</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>



    <!-- Bo góc 8 cho ảnh (ShapeableImageView) -->
    <style name="ShapeAppearance.Ft.Rounded8" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <!-- Chip hiệu ứng LED: cao 42, bo tròn, chữ Regular 16 -->
    <style name="Ft.Chip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/led_chip_height</item>
        <item name="android:background">@drawable/bg_ft_chip</item>
        <item name="android:fontFamily">@font/pathway_extreme_regular</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textColor">@color/ft_option_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Công tắc theo Figma: nút trắng, rãnh xanh/xám -->
    <style name="Ft.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:thumb">@drawable/bg_ft_switch_thumb</item>
        <item name="track">@drawable/bg_ft_switch_track</item>
        <item name="trackTint">@color/ft_switch_track</item>
        <item name="thumbTint">@android:color/white</item>
        <item name="switchMinWidth">44dp</item>
        <item name="android:background">@null</item>
    </style>

    <!-- Nút Run Style (Edge): cao 32, nền trắng, chọn = nền xanh -->
    <style name="Ft.RunStyle" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/edge_run_style_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_edge_run_style</item>
        <item name="android:fontFamily">@font/pathway_extreme_medium</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/run_style_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Nhãn thanh trượt trong thẻ Border (Edge): Medium 14 trắng -->
    <style name="Ft.Text.SliderLabel" parent="Ft.Text.CardTitle">
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Activity xem toàn màn hình (Play) -->
    <style name="Theme.App.Fullscreen" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
    </style>

</resources>
