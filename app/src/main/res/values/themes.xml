<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Dark only: the app is designed for dark UI. -->
    <style name="Base.Theme.FlashLight" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Color palette from Figma -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOutline">@color/stroke</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Default font family -->
        <item name="android:fontFamily">@font/pathway_extreme</item>
        <item name="fontFamily">@font/pathway_extreme</item>

        <!-- Default button style -->
        <item name="materialButtonStyle">@style/Widget.App.Button.Filled</item>

        <!-- Default style cho Switch / Slider / Chip, để chỉ cần dùng view chuẩn mà không phải ghi style= mỗi lần -->
        <item name="materialSwitchStyle">@style/Widget.App.Switch</item>
        <item name="sliderStyle">@style/Widget.App.Slider</item>
        <item name="chipStyle">@style/Widget.App.Chip</item>

        <!-- Transparent status bar and navigation bar with light icons for edge-to-edge -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <style name="Theme.FlashLight" parent="Base.Theme.FlashLight" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.FlashLight</item>
    </style>
</resources>
