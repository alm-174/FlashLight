<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/black" />
            <corners android:radius="@dimen/home_card_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/accent_blue_20"
                android:centerColor="@color/black_3"
                android:endColor="@color/accent_blue_20" />
            <corners android:radius="@dimen/home_card_radius" />
            <stroke android:width="1dp" android:color="@color/accent_blue_25" />
        </shape>
    </item>
</layer-list>